{
  "expo": {
    "name": "TicketPulse",
    "slug": "ticketpulse-mobile",
    "scheme": "ticketpulse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.ticketpulse.mobile"
    },
    "android": {
      "package": "tech.ticketpulse.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#071f3a"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "TicketPulse needs camera access to scan attendee QR tickets."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://ticketpulse.tech"
    }
  }
}
