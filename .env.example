# ── Auth.js ──────────────────────────────────────────────────────────────────
# Must be set to the canonical public URL of the app so Auth.js builds
# correct callback/redirect URLs. Use the custom domain, NOT the Railway
# internal domain (e.g. ticketpulse-production.up.railway.app).
AUTH_URL=https://ticketpulse.tech
AUTH_SECRET=                        # generate with: npm run auth:secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Resend (magic-link email) ─────────────────────────────────────────────────
AUTH_RESEND_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=                        # Neon Postgres connection string
