# ⚠️  WARNING
# ──────────────────────────────────────────────
# NEVER commit the actual .env.local file.
# Copy this file to .env.local and fill in your
# real values. All secrets here are placeholders.
# ──────────────────────────────────────────────

# ─── Database ─────────────────────────────────
DATABASE_URL=postgresql://user:password@host:port/db?sslmode=require

# Shared rate limiting for multi-instance deployments. If omitted, the app
# falls back to a best-effort in-memory limiter.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ─── Auth (NextAuth v5) ───────────────────────
AUTH_SECRET=generate-with-npx-auth-secret
TICKET_QR_SECRET=generate-a-separate-random-secret
# Local development only. Leave AUTH_URL/NEXTAUTH_URL unset in production so
# Auth.js preserves the incoming role subdomain (admin/organizer).
# AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Share the login session across the role subdomains in production.
AUTH_COOKIE_DOMAIN=.ticketpulse.tech

# Google OAuth — https://console.cloud.google.com
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Resend transactional email — https://resend.com
AUTH_RESEND_KEY=re_xxxxxxxxxx
ADMIN_EMAIL=admin@ticketpulse.tech
ADMIN_PHONE=263700000000,263700000001

# ─── Cloudflare R2 (media storage) ────────────
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=ticketpulse
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# ─── Payments: PesePay ────────────────────────
# https://merchant.pesepay.com
PESEPAY_INTEGRATION_KEY=your-integration-key
PESEPAY_ENCRYPTION_KEY=your-encryption-key
PESEPAY_PUBLIC_URL=https://ticketpulse.tech

# ─── Payments: Velocity Africa ────────────────
VELOCITY_BASE_URL=https://api.velocityafrica.net
VELOCITY_AUTH_MODE=x-api-key
VELOCITY_API_KEY=your-velocity-api-key
VELOCITY_MERCHANT_ACCOUNT=263700000000
VELOCITY_MERCHANT_PHONE=+263700000000
VELOCITY_ITEM_CODE=tp001
VELOCITY_TICKET_ITEM_CODE=tp001
# ─── SMS (Velocity Africa) ─────────
# POST {VELOCITY_SMS_BASE_URL}/customers/send-sms with { recipient, message }
VELOCITY_SMS_BASE_URL=https://sms.velocityafrica.net/api
VELOCITY_SMS_API_KEY=
# Fallback auth modes (only used if VELOCITY_SMS_API_KEY is unset):
VELOCITY_SMS_USERNAME=
VELOCITY_SMS_PASSWORD=
VELOCITY_AFRICA_SMS_TOKEN=
VELOCITY_SMS_TIMEOUT=30000

# ─── AI ───────────────────────────────────────
# OpenAI is preferred for all AI features when set. Groq is retained as a fallback.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ─── WhatsApp (OpenWA) ────────────────────────
OPENWA_URL=https://openwa-production-1d86.up.railway.app
OPENWA_API_KEY=owa_k1_your-key
OPENWA_SESSION_ID=your-session-id
WHATSAPP_COUNTRY_CODE=263

# ─── Internal / CRON ──────────────────────────
CRON_SECRET=generate-a-secure-random-string
INTERNAL_API_KEY=generate-another-secure-random-string

# ─── Launch Gate ──────────────────────────────
LAUNCH_PASSWORD=your-launch-password
NEXT_PUBLIC_LAUNCH_DATE=2026-05-21T18:00:00+02:00

# ─── Public ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://ticketpulse.tech

# Optional browser test credentials. Use a dedicated account in a non-production database.
E2E_BASE_URL=
E2E_ORGANIZER_EMAIL=
E2E_ORGANIZER_PASSWORD=
